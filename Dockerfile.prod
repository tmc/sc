# Production Dockerfile for Statechart Library
# Multi-stage build for optimized production images

# Stage 1: Go Builder
FROM golang:1.24-alpine AS go-builder

# Install build dependencies
RUN apk add --no-cache git make protoc protobuf-dev

# Install buf
RUN go install github.com/bufbuild/buf/cmd/buf@latest

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Generate protobuf code
RUN make generate

# Build the web visualizer
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o web-visualizer ./cmd/web-visualizer

# Stage 2: Node.js Builder
FROM node:20-alpine AS node-builder

WORKDIR /build

# Copy package files
COPY cmd/web-visualizer/package*.json ./
RUN npm ci --only=production

# Copy web assets
COPY cmd/web-visualizer/web ./web

# Build frontend assets if needed
# RUN npm run build

# Stage 3: Python Builder
FROM python:3.11-slim AS python-builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy Python SDK
COPY sdks/python ./
RUN pip install --user --no-cache-dir .[web]

# Stage 4: Final Production Image
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -S statechart && adduser -S statechart -G statechart

# Copy built artifacts
COPY --from=go-builder /build/web-visualizer /usr/local/bin/
COPY --from=node-builder /build/web /app/web
COPY --from=node-builder /build/node_modules /app/node_modules

# Set working directory
WORKDIR /app

# Change ownership
RUN chown -R statechart:statechart /app

# Switch to non-root user
USER statechart

# Expose ports
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Run the application
CMD ["web-visualizer"]

# Stage 5: Python Production Image (separate build)
FROM python:3.11-slim AS python-prod

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash statechart

# Copy Python dependencies
COPY --from=python-builder /root/.local /home/statechart/.local

# Copy Python SDK
WORKDIR /app
COPY sdks/python ./

# Change ownership
RUN chown -R statechart:statechart /app

# Switch to non-root user
USER statechart

# Update PATH
ENV PATH=/home/statechart/.local/bin:$PATH

# Expose ports
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI
CMD ["uvicorn", "statecharts.integrations.fastapi_integration:app", "--host", "0.0.0.0", "--port", "8000"]