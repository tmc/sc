  "transitions": [
    {
      "from": [
        "Search for product"
      ],
      "to": [
        "Perform search"
      ],
      "event": "Search for product",
      "guard": {
        "expression": "has permission to search",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Search for product"
      ],
      "to": [
        "Prompt for search permissions"
      ],
      "event": "Search for product"
    },
    {
      "from": [
        "Prompt for search permissions"
      ],
      "to": [
        "Perform search"
      ],
      "event": "Search permission granted"
    },
    {
      "from": [
        "Prompt for search permissions"
      ],
      "to": [
        "Prompt for search permissions"
      ],
      "event": "Search permission denied"
    },
    {
      "from": [
        "Perform search"
      ],
      "to": [
        "Product list"
      ],
      "event": "Search results"
    },
    {
      "from": [
        "Product list"
      ],
      "to": [
        "Connecting to Product"
      ],
      "event": "Connect to Product"
    },
    {
      "from": [
        "Connecting to Product"
      ],
      "to": [
        "Connected to Product"
      ],
      "event": "Connection Complete",
      "guard": {
        "expression": "Successful Connection",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Connecting to Product"
      ],
      "to": [
        "Connection Failed"
      ],
      "event": "Connection Complete",
      "guard": {
        "expression": "Connection Failed",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Connection Failed"
      ],
      "to": [
        "Connecting to Product"
      ],
      "event": "Retry Connection"
    },
    {
      "from": [
        "Connected to Product"
      ],
      "to": [
        "Setup Overview"
      ],
      "event": "Check Service Mode",
      "guard": {
        "expression": "service mode enabled",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Connected to Product"
      ],
      "to": [
        "Enable Service Mode"
      ],
      "event": "Check Service Mode",
      "guard": {
        "expression": "service mode disabled",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Enable Service Mode"
      ],
      "to": [
        "Enable Service Mode"
      ],
      "event": "Continue",
      "guard": {
        "expression": "service mode disabled",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Enable Service Mode"
      ],
      "to": [
        "Setup Overview"
      ],
      "event": "Continue",
      "guard": {
        "expression": "service mode enabled",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Check Registration Status"
      ],
      "to": [
        "Product Setup"
      ],
      "event": "Registration results",
      "guard": {
        "expression": "is registered",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Setup Overview"
      ],
      "to": [
        "Product Setup"
      ],
      "event": "Continue"
    },
    {
      "from": [
        "Check Registration Status"
      ],
      "to": [
        "Registration Required"
      ],
      "event": "Registration results",
      "guard": {
        "expression": "not registered",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Registration Required"
      ],
      "to": [
        "Check Registration Status"
      ],
      "event": "Re-check Registration"
    },
    {
      "from": [
        "Registration Required"
      ],
      "to": [
        "Registration page"
      ],
      "event": "Register"
    },
    {
      "from": [
        "Registration page"
      ],
      "to": [
        "Check Registration Status"
      ],
      "event": "Registration page done"
    },
    {
      "from": [
        "Product Setup"
      ],
      "to": [
        "Registration"
      ],
      "guard": {
        "expression": "Product unregistered",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Product Setup"
      ],
      "to": [
        "Default Settings"
      ],
      "guard": {
        "expression": "Settings not confirmed",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Settings List"
      ],
      "to": [
        "Product Setup"
      ],
      "event": "Continue",
      "guard": {
        "expression": "Valid Settings",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Settings List"
      ],
      "to": [
        "Settings List"
      ],
      "event": "Continue"
    },
    {
      "from": [
        "Product Setup"
      ],
      "to": [
        "Diagnostic Tests"
      ],
      "guard": {
        "expression": "Basic diagnostics have not been run",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Product Setup"
      ],
      "to": [
        "Activation"
      ],
      "guard": {
        "expression": "product is not activated",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Product Setup"
      ],
      "to": [
        "Setup Complete"
      ]
    },
    {
      "from": [
        "Check Activation"
      ],
      "to": [
        "Activation success"
      ],
      "event": "Activation result",
      "guard": {
        "expression": "success",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Check Activation"
      ],
      "to": [
        "Activation Failed"
      ],
      "event": "Activation result"
    },
    {
      "from": [
        "Activation Failed"
      ],
      "to": [
        "Check Activation"
      ],
      "event": "Retry Activation"
    },
    {
      "from": [
        "Activation success"
      ],
      "to": [
        "Product Setup"
      ]
    },
    {
      "from": [
        "Basic Diagnostics"
      ],
      "to": [
        "Product Setup"
      ],
      "event": "Diagnostics Results",
      "guard": {
        "expression": "success",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Basic Diagnostics"
      ],
      "to": [
        "Basic Diagnostics"
      ],
      "event": "Diagnostics Results"
    }
  ],
