      ],
      "to": [
        "MP4 posted"
      ],
      "event": "MP4 Created"
    },
    {
      "from": [
        "GIF Posted"
      ],
      "to": [
        "Concatenating MOVs to MP4"
      ],
      "guard": {
        "expression": "all segments are done",
        "language": "xstate"
      }
    }
