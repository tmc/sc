{
  "name": "chatbot",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "chatbot",
        "type": 2,
        "children": [
          {
            "label": "idle",
            "type": 1,
            "is_initial": true,
            "metadata": {
              "stately_id": "chatbot.idle"
            }
          },
          {
            "label": "checking_reviews",
            "type": 1,
            "entry_actions": [
              {
                "label": "New action",
                "language": "xstate"
              }
            ],
            "metadata": {
              "stately_id": "chatbot.checking_reviews"
            }
          },
          {
            "label": "fetching_reviews",
            "type": 1,
            "metadata": {
              "stately_id": "chatbot.fetching_reviews"
            }
          }
        ],
        "is_initial": true,
        "metadata": {
          "stately_id": "chatbot"
        }
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "idle"
      ],
      "to": [
        "checking_reviews"
      ],
      "event": "ADD_URL",
      "actions": [
        {
          "label": "inline:chatbot.idle#ADD_URL[-1]#transition[0]",
          "language": "xstate"
        }
      ]
    },
    {
      "from": [
        "checking_reviews"
      ],
      "to": [
        "fetching_reviews"
      ],
      "guard": {
        "expression": "inline:chatbot.checking_reviews#xstate.after(500)#chatbot.checking_reviews[-1]#guard",
        "language": "xstate"
      }
    }
  ],
  "events": [
    {
      "label": "ADD_URL"
    }
  ],
  "variables": {
    "isLoading": false,
    "productId": "",
    "productUrl": ""
  }
}