                }
              }
            ],
            "exit_actions": [
              {
                "label": "toggleProfileGate",
                "language": "xstate",
                "parameters": {
                  "isProfileGateOpen": false
                }
              }
            ],
            "metadata": {
              "stately_id": "AuthFlow.WhoIsWatching"
