{
  "name": "White noise machine",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "White noise machine",
        "type": 2,
        "children": [
          {
            "label": "Power on",
            "type": 3,
            "children": [
              {
                "label": "Sound",
                "type": 2,
                "children": [
                  {
                    "label": "White noise",
                    "type": 1,
                    "is_initial": true,
                    "entry_actions": [
                      {
                        "label": "changeToNoise",
                        "language": "xstate"
                      }
                    ],
                    "metadata": {
                      "meta_entries": [],
                      "stately_id": "White noise machine.Power on.Sound.White noise"
                    }
                  },
                  {
                    "label": "Waves",
                    "type": 1,
                    "entry_actions": [
                      {
                        "label": "changeToWaves",
                        "language": "xstate"
                      }
                    ],
                    "metadata": {
                      "meta_entries": [],
                      "stately_id": "White noise machine.Power on.Sound.Waves"
                    }
                  }
                ],
                "metadata": {
                  "meta_entries": [],
                  "stately_id": "White noise machine.Power on.Sound"
                }
              },
              {
                "label": "Light",
                "type": 2,
                "children": [
                  {
                    "label": "Light off",
                    "type": 1,
                    "is_initial": true,
                    "entry_actions": [
                      {
                        "label": "removeColour",
                        "language": "xstate"
                      }
                    ],
                    "metadata": {
                      "stately_id": "White noise machine.Power on.Light.Light off"
                    }
                  },
                  {
                    "label": "Yellow",
                    "type": 1,
                    "entry_actions": [
                      {
                        "label": "setYellow",
                        "language": "xstate"
                      }
                    ],
                    "metadata": {
                      "stately_id": "White noise machine.Power on.Light.Yellow"
                    }
                  },
                  {
                    "label": "Blue",
                    "type": 1,
                    "entry_actions": [
                      {
                        "label": "setBlue",
                        "language": "xstate"
                      }
                    ],
                    "metadata": {
                      "stately_id": "White noise machine.Power on.Light.Blue"
                    }
                  },
                  {
                    "label": "Green",
                    "type": 1,
                    "entry_actions": [
                      {
                        "label": "setGreen",
                        "language": "xstate"
                      }
                    ],
                    "metadata": {
                      "stately_id": "White noise machine.Power on.Light.Green"
                    }
                  }
                ],
                "exit_actions": [
                  {
                    "label": "removeColour",
                    "language": "xstate"
                  }
                ],
                "metadata": {
                  "stately_id": "White noise machine.Power on.Light"
                }
              },
              {
                "label": "Volume",
                "type": 1,
                "metadata": {
                  "stately_id": "White noise machine.Power on.Volume"
                }
              }
            ],
            "entry_actions": [
              {
                "label": "showButtons",
                "language": "xstate"
              },
              {
                "label": "setVolume",
                "language": "xstate"
              },
              {
                "label": "play",
                "language": "xstate"
              }
            ],
            "exit_actions": [
              {
                "label": "hideButtons",
                "language": "xstate"
              },
              {
                "label": "pause",
                "language": "xstate"
              }
            ],
            "metadata": {
              "invoke": [
                {
                  "id": "audioPlayer",
                  "input": {},
                  "kind": "named",
                  "settings": {},
                  "src": "audioPlayer"
                }
              ],
              "meta_entries": [],
              "stately_id": "White noise machine.Power on"
            }
          },
          {
            "label": "Power off",
            "type": 1,
            "is_initial": true,
            "entry_actions": [
              {
                "label": "hideButtons",
                "language": "xstate"
              }
            ],
            "metadata": {
              "description": "We need power states because\n\nbrowsers don’t like autoplaying audio.",
              "meta_entries": [],
              "stately_id": "White noise machine.Power off"
            }
          }
        ],
        "is_initial": true,
        "metadata": {
          "meta_entries": [
            [
              "gitHubUrl",
              "https://github.com/laurakalbag/whitenoise-demo/blob/43d996b7b794c411a397b9b8094fdb23af2c3f4d/machine.js"
            ]
          ],
          "stately_id": "White noise machine"
        }
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "White noise"
      ],
      "to": [
        "Waves"
      ],
      "event": "toggle sound"
    },
    {
      "from": [
        "Light off"
      ],
      "to": [
        "Yellow"
      ],
      "event": "toggle light"
    },
    {
      "from": [
        "Yellow"
      ],
      "to": [
        "Blue"
      ],
      "event": "toggle light"
    },
    {
      "from": [
        "Blue"
      ],
      "to": [
        "Green"
      ],
      "event": "toggle light"
    },
    {
      "from": [
        "Green"
      ],
      "to": [
        "Light off"
      ],
      "event": "toggle light"
    },
    {
      "from": [
        "Volume"
      ],
      "to": [
        "Volume"
      ],
      "event": "volume up",
      "guard": {
        "expression": "isNotMaxVolume",
        "language": "xstate"
      },
      "actions": [
        {
          "label": "volUp",
          "language": "xstate"
        },
        {
          "label": "volumeUp",
          "language": "xstate"
        }
      ]
    },
    {
      "from": [
        "Volume"
      ],
      "to": [
        "Volume"
      ],
      "event": "volume down",
      "guard": {
        "expression": "isNotMinVolume",
        "language": "xstate"
      },
      "actions": [
        {
          "label": "volDown",
          "language": "xstate"
        },
        {
          "label": "volumeDown",
          "language": "xstate"
        }
      ]
    },
    {
      "from": [
        "Waves"
      ],
      "to": [
        "White noise"
      ],
      "event": "toggle sound"
    },
    {
      "from": [
        "Power off"
      ],
      "to": [
        "Power on"
      ],
      "event": "toggle power"
    },
    {
      "from": [
        "Power on"
      ],
      "to": [
        "Power off"
      ],
      "event": "toggle power"
    }
  ],
  "events": [
    {
      "label": "toggle sound"
    },
    {
      "label": "toggle light"
    },
    {
      "label": "volume up"
    },
    {
      "label": "volume down"
    },
    {
      "label": "toggle power"
    }
  ],
  "variables": {
    "volume": 5
  }
}