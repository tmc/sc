{
  "name": "ObservableInboxMachine",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "ObservableInboxMachine",
        "type": 2,
        "children": [
          {
            "label": "Working",
            "type": 2,
            "children": [
              {
                "label": "Idle",
                "type": 1,
                "is_initial": true,
                "metadata": {
                  "stately_id": "ObservableInboxMachine.Working.Idle"
                }
              },
              {
                "label": "ObservingInbox",
                "type": 1,
                "metadata": {
                  "invoke": [
                    {
                      "id": "inboxObserver",
                      "input": {},
                      "kind": "named",
                      "settings": {},
                      "src": "inboxObserver"
                    }
                  ],
                  "stately_id": "ObservableInboxMachine.Working.ObservingInbox"
                }
              },
              {
                "label": "GettingLastOpenedDate",
                "type": 1,
                "metadata": {
                  "invoke": [
                    {
                      "id": "inboxMetadataReader",
                      "input": {},
                      "kind": "named",
                      "settings": {},
                      "src": "inboxMetadataReader"
                    }
                  ],
                  "stately_id": "ObservableInboxMachine.Working.GettingLastOpenedDate"
                }
              },
              {
                "label": "Hist",
                "type": 1,
                "is_history": true,
                "history_type": 1,
                "metadata": {
                  "stately_id": "ObservableInboxMachine.Working.Hist"
                }
              }
            ],
            "is_initial": true,
            "metadata": {
              "stately_id": "ObservableInboxMachine.Working"
            }
          },
          {
            "label": "WaitingToRetry",
            "type": 1,
            "metadata": {
              "stately_id": "ObservableInboxMachine.WaitingToRetry"
            }
          }
        ],
        "is_initial": true,
        "metadata": {
          "stately_id": "ObservableInboxMachine"
        }
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Idle"
      ],
      "to": [
        "GettingLastOpenedDate"
      ],
      "event": "StartObservingEvent"
    },
    {
      "from": [
        "ObservingInbox"
      ],
      "to": [
        "Idle"
      ],
      "event": "StopObservingEvent"
    },
    {
      "from": [
        "GettingLastOpenedDate"
      ],
      "to": [
        "ObservingInbox"
      ]
    },
    {
      "from": [
        "GettingLastOpenedDate"
      ],
      "to": [
        "WaitingToRetry"
      ]
    },
    {
      "from": [
        "ObservingInbox"
      ],
      "to": [
        "WaitingToRetry"
      ]
    },
    {
      "from": [
        "WaitingToRetry"
      ],
      "to": [
        "Hist"
      ],
      "event": "RetryEvent"
    }
  ],
  "events": [
    {
      "label": "RetryEvent"
    },
    {
      "label": "StartObservingEvent"
    },
    {
      "label": "StopObservingEvent"
    }
  ]
}