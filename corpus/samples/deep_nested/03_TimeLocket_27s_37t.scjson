  "transitions": [
    {
      "from": [
        "TimeLocket"
      ],
      "to": [
        "TimeLocket View"
      ],
      "event": "User Clicks Project to View"
    },
    {
      "from": [
        "Project Phase(s) + Task(s) List"
      ],
      "to": [
        "Project Phase(s) + Task(s) List"
      ],
      "event": "Add Task to Project Phase"
    },
    {
      "from": [
        "Project Phase(s) + Task(s) List"
      ],
      "to": [
        "Project Phase(s) + Task(s) List"
      ],
      "event": "Add/Edit/Delete Phase(s)"
    },
    {
      "from": [
        "Material Takeoff List"
      ],
      "to": [
        "Selected Material: Takeoff Details Screen"
      ],
      "event": "Search + Add Material to List"
    },
    {
      "from": [
        "Selected Material: Takeoff Details Screen"
      ],
      "to": [
        "Material Takeoff List"
      ],
      "event": "Enter Details (dimensions/quantity/etc) + Save"
    },
    {
      "from": [
        "Material Takeoff List"
      ],
      "to": [
        "Confirm Material Screen"
      ],
      "event": "Click to add Material to Cart"
    },
    {
      "from": [
        "Confirm Material Screen"
      ],
      "to": [
        "Material Takeoff List"
      ],
      "event": "Return to List"
    },
    {
      "from": [
        "Confirm Material Screen"
      ],
      "to": [
        "\"Assign to Task?\" Screen"
      ],
      "event": "Confirm quantity, dimensions, etc."
    },
    {
      "from": [
        "\"Assign to Task?\" Screen"
      ],
      "to": [
        "Project Phases and Tasks Overview Screen"
      ],
      "event": "Yes"
    },
    {
      "from": [
        "\"Assign to Task?\" Screen"
      ],
      "to": [
        "Cart"
      ],
      "event": "No"
    },
    {
      "from": [
        "Project Phases and Tasks Overview Screen"
      ],
      "to": [
        "Cart"
      ],
      "event": "Select Project Phase Task to Assign to \u0026 Proceed"
    },
    {
      "from": [
        "My Cart"
      ],
      "to": [
        "Order Confirmed Screen"
      ],
      "event": "Confirm Details + Place Order"
    },
    {
      "from": [
        "My Cart"
      ],
      "to": [
        "My Cart"
      ],
      "event": "Edit/Remove Cart Items"
    },
    {
      "from": [
        "Order Confirmed Screen"
      ],
      "to": [
        "Subscription / Transfer Ownership"
      ],
      "event": "Add to Calendar"
    },
    {
      "from": [
        "Project Phase(s) + Task(s) List"
      ],
      "to": [
        "Subscription / Transfer Ownership"
      ],
      "event": "Display Phases + Tasks in Calendar"
    },
    {
      "from": [
        "Order Confirmed Screen"
      ],
      "to": [
        "Invoices (Order History)"
      ],
      "event": "Store Order Details in Project Invoice (Order history)"
    },
    {
      "from": [
        "List of User's (contractor or subcontractor) Purchases for all Projects"
      ],
      "to": [
        "Payment Pending Invoice"
      ],
      "event": "Click \"Request Payment\"",
      "guard": {
        "expression": "Project + All Tasks are Completed",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Payment Pending Invoice"
      ],
      "to": [
        "Completed Invoice Details Saved"
      ],
      "event": "Payment Received"
    },
    {
      "from": [
        "Completed Invoice Details Saved"
      ],
      "to": [
        "List of User's (contractor or subcontractor) Purchases for all Projects"
      ],
      "event": "Return to Invoices Screen"
    },
    {
      "from": [
        "List of User's (contractor or subcontractor) Purchases for all Projects"
      ],
      "to": [
        "All Purchases and Details for selected Project"
      ],
      "event": "Click Project/Invoice"
    },
    {
      "from": [
        "All Purchases and Details for selected Project"
      ],
      "to": [
        "List of User's (contractor or subcontractor) Purchases for all Projects"
      ],
      "event": "Return to Invoices Screen"
    },
    {
      "from": [
        "TimeLocket"
      ],
      "to": [
        "Project Name"
      ],
      "event": "User creates, and names, a New Project"
    },
    {
      "from": [
        "Project Name"
      ],
      "to": [
        "Project w/ Images, Description, Relevant Files"
      ],
      "event": "Enter General Details"
    },
    {
      "from": [
        "Project w/ Images, Description, Relevant Files"
      ],
      "to": [
        "Review Project Details Screen"
      ],
      "event": "Enter Project Phases and Tasks (optional)"
    },
    {
      "from": [
        "Project w/ Images, Description, Relevant Files"
      ],
      "to": [
        "Project w/ Images, Description, Relevant Files"
      ],
      "event": "Add Project Members or Skip \u0026 Add Later"
    },
    {
      "from": [
        "Review Project Details Screen"
      ],
      "to": [
        "TimeLocket View"
      ],
      "event": "SAVE"
    },
    {
      "from": [
        "TimeLocket Primary Page"
      ],
      "to": [
        "Project Phases and Tasks Overview Screen"
      ],
      "event": "Click \"People\""
    },
    {
      "from": [
        "TimeLocket Primary Page"
      ],
      "to": [
        "Project Materials: MTOL"
      ],
      "event": "Click \"Add Media\""
    },
    {
      "from": [
        "Subscription Status + Ownership Transfer"
      ],
      "to": [
        "Transfer Ownership - New"
      ],
      "event": "Click \"Transfer Ownership\"",
      "guard": {
        "expression": "No current Ownership transfer set",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Transfer Ownership - New"
      ],
      "to": [
        "View Transfer Details"
      ],
      "event": "Select person from in-app friends list + select date of transfer"
    },
    {
      "from": [
        "TimeLocket View"
      ],
      "to": [
        "Invoices (Order History)"
      ],
      "event": "Navigate to Profile --\u003e Invoices (Order History)"
    },
    {
      "from": [
        "TimeLocket Primary Page"
      ],
      "to": [
        "Subscription / Transfer Ownership"
      ],
      "event": "Click \"Subscription\""
    },
    {
      "from": [
        "Subscription Status + Ownership Transfer"
      ],
      "to": [
        "Ownership Transfer Details"
      ],
      "event": "Click \"Modify Ownership Transfer\""
    },
    {
      "from": [
        "View Transfer Details"
      ],
      "to": [
        "Subscription Status + Ownership Transfer"
      ],
      "event": "Click Confirm button"
    },
    {
      "from": [
        "Ownership Transfer Details"
      ],
      "to": [
        "Ownership Transfer Details"
      ],
      "event": "Modify Transfer Date"
    },
    {
      "from": [
        "Ownership Transfer Details"
      ],
      "to": [
        "Subscription Status + Ownership Transfer"
      ],
      "event": "Cancel Transfer"
    },
    {
      "from": [
        "Ownership Transfer Details"
      ],
      "to": [
        "Transfer Ownership - New"
      ],
      "event": "Modify Transfer Recipient"
    }
  ],
