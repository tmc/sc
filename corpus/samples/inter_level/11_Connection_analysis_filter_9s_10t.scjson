        "expression": "Affect with Stop",
        "language": "xstate"
      }
    },
    {
      "from": [
        "filtered"
      ],
      "to": [
        "no conflict"
      ],
      "event": "set transportsystem and line filter"
    },
    {
      "from": [
        "no filter"
      ],
      "to": [
