    },
    {
      "from": [
        "no filter"
      ],
      "to": [
        "filtered with conflict"
      ],
      "event": "set filter",
      "guard": {
        "expression": "Affect with stop",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Stops selected"
      ],
      "to": [
        "Stops selected"
      ],
      "event": "Add stop"
    },
    {
      "from": [
        "Stops selected"
      ],
      "to": [
        "Stops selected"
      ],
      "event": "Remove stop",
      "guard": {
        "expression": "Has stop selected?",
        "language": "xstate"
      }
    },
    {
      "from": [
        "Stops selected"
      ],
      "to": [
        "no stop selected"
      ],
      "event": "Remove stop"
    },
    {
      "from": [
        "filtered"
      ],
      "to": [
