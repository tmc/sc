        "isInitial": true
      },
      {
        "label": "deep_review_session",
        "type": "STATE_TYPE_OR",
        "children": [
          {
            "label": "deep_review_collect",
            "type": "STATE_TYPE_OR",
            "isInitial": true,
            "children": [
              {
                "label": "deep_review_capture",
                "type": "STATE_TYPE_BASIC",
                "isInitial": true
              },
              {
                "label": "deep_review_label",
                "type": "STATE_TYPE_BASIC"
              }
            ]
          },
          {
            "label": "deep_review_review",
            "type": "STATE_TYPE_OR",
            "children": [
              {
                "label": "deep_review_inspect",
                "type": "STATE_TYPE_BASIC",
                "isInitial": true
              },
              {
                "label": "deep_review_approve",
                "type": "STATE_TYPE_BASIC"
              },
              {
                "label": "deep_review_reject",
                "type": "STATE_TYPE_BASIC"
              }
            ]
          },
          {
            "label": "deep_review_archive",
            "type": "STATE_TYPE_OR",
            "children": [
              {
                "label": "deep_review_pack",
