{
  "name": "Counter",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Zero",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Counting",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Done",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Zero"
      ],
      "to": [
        "Counting"
      ],
      "event": "START"
    },
    {
      "from": [
        "Counting"
      ],
      "to": [
        "Counting"
      ],
      "event": "INCREMENT",
      "guard": "count < 10"
    },
    {
      "from": [
        "Counting"
      ],
      "to": [
        "Done"
      ],
      "event": "INCREMENT",
      "guard": "count >= 10"
    },
    {
      "from": [
        "Done"
      ],
      "to": [
        "Zero"
      ],
      "event": "RESET"
    }
  ]
}