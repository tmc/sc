{
  "name": "Login",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "LoggedOut",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "LoggedIn",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Locked",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "LoggedOut"
      ],
      "to": [
        "LoggedIn"
      ],
      "event": "LOGIN",
      "guard": "password_correct"
    },
    {
      "from": [
        "LoggedOut"
      ],
      "to": [
        "Locked"
      ],
      "event": "LOGIN",
      "guard": "attempts >= 3"
    },
    {
      "from": [
        "LoggedIn"
      ],
      "to": [
        "LoggedOut"
      ],
      "event": "LOGOUT"
    },
    {
      "from": [
        "Locked"
      ],
      "to": [
        "LoggedOut"
      ],
      "event": "TIMEOUT"
    }
  ]
}