{
  "name": "Battery",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Normal",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Warning",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Critical",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Normal"
      ],
      "to": [
        "Warning"
      ],
      "event": "CHECK",
      "guard": "level < 20"
    },
    {
      "from": [
        "Warning"
      ],
      "to": [
        "Critical"
      ],
      "event": "CHECK",
      "guard": "level < 5"
    },
    {
      "from": [
        "Warning"
      ],
      "to": [
        "Normal"
      ],
      "event": "CHARGE",
      "guard": "level >= 20"
    },
    {
      "from": [
        "Critical"
      ],
      "to": [
        "Warning"
      ],
      "event": "CHARGE",
      "guard": "level >= 5"
    }
  ]
}