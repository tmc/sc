{
  "name": "Download",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Idle",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Downloading",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Complete",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Idle"
      ],
      "to": [
        "Downloading"
      ],
      "event": "START"
    },
    {
      "from": [
        "Downloading"
      ],
      "to": [
        "Complete"
      ],
      "event": "DONE"
    },
    {
      "from": [
        "Complete"
      ],
      "to": [
        "Idle"
      ],
      "event": "RESET"
    }
  ]
}