{
  "name": "Timer",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Stopped",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Running",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Paused",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Alarm",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Stopped"
      ],
      "to": [
        "Running"
      ],
      "event": "START"
    },
    {
      "from": [
        "Running"
      ],
      "to": [
        "Paused"
      ],
      "event": "PAUSE"
    },
    {
      "from": [
        "Paused"
      ],
      "to": [
        "Running"
      ],
      "event": "RESUME"
    },
    {
      "from": [
        "Running"
      ],
      "to": [
        "Alarm"
      ],
      "event": "TIMEOUT"
    },
    {
      "from": [
        "Alarm"
      ],
      "to": [
        "Stopped"
      ],
      "event": "RESET"
    }
  ]
}