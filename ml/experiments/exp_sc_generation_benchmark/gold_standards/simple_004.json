{
  "name": "Toggle",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Inactive",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Active",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Inactive"
      ],
      "to": [
        "Active"
      ],
      "event": "ACTIVATE"
    },
    {
      "from": [
        "Active"
      ],
      "to": [
        "Inactive"
      ],
      "event": "DEACTIVATE"
    }
  ]
}