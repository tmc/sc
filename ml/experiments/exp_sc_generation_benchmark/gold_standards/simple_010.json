{
  "name": "Process",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Ready",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Running",
        "type": 1,
        "is_initial": false
      },
      {
        "label": "Finished",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Ready"
      ],
      "to": [
        "Running"
      ],
      "event": "START"
    },
    {
      "from": [
        "Running"
      ],
      "to": [
        "Finished"
      ],
      "event": "COMPLETE"
    },
    {
      "from": [
        "Finished"
      ],
      "to": [
        "Ready"
      ],
      "event": "RESET"
    }
  ]
}