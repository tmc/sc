{
  "name": "Game",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Menu",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Playing",
        "type": 2,
        "is_initial": false,
        "children": [
          {
            "label": "InGame",
            "type": 1,
            "is_initial": true
          },
          {
            "label": "Paused",
            "type": 1,
            "is_initial": false
          }
        ]
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Menu"
      ],
      "to": [
        "InGame"
      ],
      "event": "START"
    },
    {
      "from": [
        "InGame"
      ],
      "to": [
        "Paused"
      ],
      "event": "PAUSE"
    },
    {
      "from": [
        "Paused"
      ],
      "to": [
        "InGame"
      ],
      "event": "RESUME"
    },
    {
      "from": [
        "Playing"
      ],
      "to": [
        "Menu"
      ],
      "event": "QUIT"
    }
  ]
}