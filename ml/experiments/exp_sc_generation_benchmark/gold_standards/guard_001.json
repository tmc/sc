{
  "name": "DoorLock",
  "root_state": {
    "label": "__root__",
    "type": 2,
    "children": [
      {
        "label": "Locked",
        "type": 1,
        "is_initial": true
      },
      {
        "label": "Unlocked",
        "type": 1,
        "is_initial": false
      }
    ]
  },
  "transitions": [
    {
      "from": [
        "Locked"
      ],
      "to": [
        "Unlocked"
      ],
      "event": "ENTER_PIN",
      "guard": "pin == correct_pin"
    },
    {
      "from": [
        "Unlocked"
      ],
      "to": [
        "Locked"
      ],
      "event": "LOCK"
    }
  ]
}