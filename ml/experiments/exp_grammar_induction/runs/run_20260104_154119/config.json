{
  "max_files": 200,
  "include_stdlib": true,
  "stdlib_packages": [
    "fmt",
    "io",
    "os",
    "net",
    "http",
    "strings",
    "bytes",
    "strconv",
    "sort",
    "sync",
    "context",
    "errors",
    "time",
    "encoding/json",
    "encoding/xml",
    "path/filepath",
    "regexp",
    "bufio",
    "container/list",
    "container/heap",
    "crypto",
    "database/sql",
    "flag",
    "log",
    "math",
    "reflect",
    "runtime",
    "testing",
    "text/template"
  ],
  "hidden_dim": 256,
  "num_layers": 6,
  "num_heads": 8,
  "ff_dim": 1024,
  "max_seq_len": 512,
  "dropout": 0.1,
  "transformer_epochs": 15,
  "transformer_lr": 0.0001,
  "batch_size": 32,
  "sae_expansion": 16,
  "sae_k_active": 32,
  "sae_epochs": 10,
  "sae_lr": 0.001,
  "threshold_state_coverage": 0.7,
  "threshold_transition_accuracy": 0.8,
  "threshold_accept_reject": 0.95,
  "threshold_edge_cases": 0.85
}