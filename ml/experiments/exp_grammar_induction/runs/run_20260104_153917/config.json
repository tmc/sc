{
  "max_files": 50,
  "include_stdlib": true,
  "stdlib_packages": [
    "fmt",
    "io",
    "os",
    "strings"
  ],
  "hidden_dim": 64,
  "num_layers": 2,
  "num_heads": 4,
  "ff_dim": 256,
  "max_seq_len": 128,
  "dropout": 0.1,
  "transformer_epochs": 5,
  "transformer_lr": 0.001,
  "batch_size": 16,
  "sae_expansion": 8,
  "sae_k_active": 16,
  "sae_epochs": 3,
  "sae_lr": 0.001,
  "threshold_state_coverage": 0.5,
  "threshold_transition_accuracy": 0.6,
  "threshold_accept_reject": 0.8,
  "threshold_edge_cases": 0.75
}