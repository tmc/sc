{
  "root": "Statechart",
  "definitions": {
    "Statechart": {
      "type": "object",
      "properties": {
        "root_state": {
          "$ref": "#/definitions/State"
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Transition"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Event"
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": true
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "root_state",
        "events"
      ]
    },
    "State": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "option allow_alias",
            "STATE_TYPE_UNSPECIFIED",
            "STATE_TYPE_BASIC",
            "STATE_TYPE_OR",
            "STATE_TYPE_AND",
            "STATE_TYPE_NORMAL",
            "STATE_TYPE_PARALLEL",
            "STATE_TYPE_ORTHOGONAL"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/State"
          }
        },
        "is_initial": {
          "type": "boolean"
        },
        "is_final": {
          "type": "boolean"
        },
        "entry_actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "exit_actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "is_history": {
          "type": "boolean"
        },
        "history_type": {
          "type": "string",
          "enum": [
            "HISTORY_TYPE_UNSPECIFIED",
            "HISTORY_TYPE_SHALLOW",
            "HISTORY_TYPE_DEEP"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "type"
      ]
    },
    "Transition": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event": {
          "type": "string"
        },
        "guard": {
          "$ref": "#/definitions/Guard"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "priority": {
          "type": "integer"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "from",
        "to",
        "event"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "Guard": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/Expression"
        }
      },
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "body": {
          "$ref": "#/definitions/Expression"
        }
      },
      "additionalProperties": false
    },
    "StateRef": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Configuration": {
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StateRef"
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Configuration"
          }
        }
      },
      "additionalProperties": false
    },
    "Machine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "MACHINE_STATE_UNSPECIFIED",
            "MACHINE_STATE_RUNNING",
            "MACHINE_STATE_STOPPED"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        },
        "statechart": {
          "$ref": "#/definitions/Statechart"
        },
        "configuration": {
          "$ref": "#/definitions/Configuration"
        },
        "step_history": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Step"
          }
        }
      },
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Event"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Transition"
          }
        },
        "starting_configuration": {
          "$ref": "#/definitions/Configuration"
        },
        "resulting_configuration": {
          "$ref": "#/definitions/Configuration"
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        },
        "states_entered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states_exited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions_executed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          }
        }
      },
      "additionalProperties": false
    },
    "Expression": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EXPRESSION_TYPE_UNSPECIFIED",
            "EXPRESSION_TYPE_RAW",
            "EXPRESSION_TYPE_CEL",
            "EXPRESSION_TYPE_STARLARK"
          ]
        },
        "source": {
          "type": "string"
        },
        "cel_ast": {
          "type": "string",
          "encoding": "base64"
        },
        "cel_checked": {
          "type": "string",
          "encoding": "base64"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "ExpressionSecurityConfig": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer"
        },
        "max_execution_ms": {
          "type": "integer"
        },
        "max_memory_bytes": {
          "type": "integer"
        },
        "allowed_functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_starlark": {
          "type": "boolean"
        },
        "allow_starlark_loops": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}