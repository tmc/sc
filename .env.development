# Development environment variables for statechart library
# Copy this file to .env.local and modify as needed for your local setup

# ============================================================================
# Core Application Settings
# ============================================================================

# Environment
NODE_ENV=development
GO_ENV=development
RUST_LOG=debug
PYTHONPATH=/workspace/sdks/python

# ============================================================================
# Web Services Configuration
# ============================================================================

# Web Visualizer
PORT=8080
WEB_VISUALIZER_PORT=8080
WEB_VISUALIZER_HOST=0.0.0.0

# Development servers
DEV_SERVER_PORT=3000
DOCS_SERVER_PORT=6060
DOCS_HTTP_PORT=8888

# Python services
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
FASTAPI_PORT=8000

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL (for persistence, if needed)
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=statechart_dev
POSTGRES_USER=statechart
POSTGRES_PASSWORD=statechart_dev_pass
DATABASE_URL=postgresql://statechart:statechart_dev_pass@database:5432/statechart_dev

# Redis (for caching, if needed)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Development Tools Configuration
# ============================================================================

# Debugging
GO_DELVE_PORT=40000
NODE_INSPECT_PORT=9229

# Hot reload
WATCH_MODE=true
AUTO_RELOAD=true

# Testing
TEST_TIMEOUT=30s
COVERAGE_THRESHOLD=80

# ============================================================================
# Build Configuration
# ============================================================================

# Go settings
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
CGO_ENABLED=1

# Rust settings
CARGO_TARGET_DIR=/workspace/target
RUST_BACKTRACE=1

# Node.js settings
NPM_CONFIG_CACHE=/root/.npm
NODE_OPTIONS=--max-old-space-size=4096

# Protocol Buffers
PROTOC_VERSION=25.1
BUF_VERSION=latest

# ============================================================================
# Monitoring and Observability
# ============================================================================

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_CONFIG=/etc/prometheus/prometheus.yml

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# ============================================================================
# Development Workflow
# ============================================================================

# Code generation
AUTO_GENERATE_PROTO=true
WATCH_PROTO_FILES=true

# Testing
RUN_TESTS_ON_CHANGE=false
PARALLEL_TESTS=true

# File watching
IGNORE_PATTERNS=*.log,*.tmp,node_modules,target,__pycache__

# ============================================================================
# Security (Development Only)
# ============================================================================

# CORS settings for development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true

# API settings
API_RATE_LIMIT_DISABLED=true
AUTH_DISABLED=true

# ============================================================================
# Performance Tuning
# ============================================================================

# Container resource limits (for docker-compose)
MEMORY_LIMIT=2g
CPU_LIMIT=2.0

# Concurrent operations
MAX_WORKERS=4
PARALLEL_BUILDS=true

# ============================================================================
# File System Configuration
# ============================================================================

# Data directories
DATA_DIR=/workspace/data
LOGS_DIR=/workspace/logs
TEMP_DIR=/workspace/tmp

# Persistence
ENABLE_PERSISTENCE=true
BACKUP_INTERVAL=1h

# ============================================================================
# Advanced Development Features
# ============================================================================

# Profiling
ENABLE_PROFILING=false
PROFILE_PORT=6060

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Tracing
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Feature flags
EXPERIMENTAL_FEATURES=true
DEBUG_MODE=true
VERBOSE_LOGGING=true