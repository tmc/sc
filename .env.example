# Example environment variables for Docker development
# Copy this to .env and adjust as needed

# PostgreSQL Configuration
POSTGRES_USER=statechart
POSTGRES_PASSWORD=statechart
POSTGRES_DB=statechart

# Redis Configuration
REDIS_PASSWORD=

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Go Configuration
GO111MODULE=on
GOPROXY=https://proxy.golang.org,direct
CGO_ENABLED=1

# Python Configuration
PYTHONPATH=/workspace/sdks/python
FLASK_ENV=development
FLASK_DEBUG=1

# Node.js Configuration
NODE_ENV=development

# Rust Configuration
RUST_BACKTRACE=1
CARGO_HOME=/workspace/.cache/cargo

# API Keys (if needed)
# API_KEY=your-api-key-here

# Feature Flags
ENABLE_PERSISTENCE=true
ENABLE_WEBSOCKET=true
ENABLE_EXPORT=true